# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pragyam

# Brevo (https://brevo.com) API key for transactional emails
BREVO_API_KEY=your_brevo_api_key_here
# Sender verified in Brevo, as "Name <address>"
EMAIL_FROM=Pragyam 2.0 <you@yourdomain.com>

# Shared secret password for the admin dashboard (no accounts, just this password)
ADMIN_SECRET=choose-a-long-random-password

# Public site URL (used in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
